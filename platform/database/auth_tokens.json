{
  "name": "auth_tokens",
  "columns": [
    {"name": "selector_hash", "type": "CHAR(64)"},
    {"name": "secret_hash", "type": "CHAR(64)", "nullable": true},
    {"name": "user_id", "type": "BIGINT UNSIGNED"},
    {"name": "purpose", "type": "VARCHAR(40)"},
    {"name": "expires_at", "type": "DATETIME"},
    {"name": "attempts", "type": "INT UNSIGNED", "default": 0},
    {"name": "created_at", "type": "TIMESTAMP", "default_expression": "CURRENT_TIMESTAMP"}
  ],
  "primary_key": ["selector_hash"],
  "indexes": [
    {"name": "idx_auth_tokens_user_purpose", "columns": ["user_id", "purpose"]},
    {"name": "idx_auth_tokens_expires", "columns": ["expires_at"]}
  ],
  "foreign_keys": [
    {"name": "fk_auth_tokens_user", "columns": ["user_id"], "references": "users", "reference_columns": ["id"], "on_delete": "CASCADE"}
  ]
}
