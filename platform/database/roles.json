{
  "name": "roles",
  "columns": [
    {"name": "id", "type": "BIGINT UNSIGNED", "auto_increment": true},
    {"name": "name", "type": "VARCHAR(100)"},
    {"name": "slug", "type": "VARCHAR(100)"},
    {"name": "description", "type": "VARCHAR(255)", "nullable": true},
    {"name": "created_at", "type": "TIMESTAMP", "default_expression": "CURRENT_TIMESTAMP"}
  ],
  "primary_key": ["id"],
  "indexes": [
    {"name": "uq_roles_name", "columns": ["name"], "unique": true},
    {"name": "uq_roles_slug", "columns": ["slug"], "unique": true}
  ]
}
